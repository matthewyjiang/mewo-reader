<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist overrides for xtool builds (see xtool.yml). xtool fills in the
  bundle id, executable, and MinimumOSVersion. Keep the rest in sync with
  Mewo/Resources/Info.plist and the versions in project.yml.
  Asset-catalog keys (icons, launch screen color/image) are left out because
  xtool does not compile Assets.xcassets.
  Xcode's embed-build-identity script overwrites CFBundleShortVersionString
  from git describe and adds MewoGitCommit. xtool does not run that script,
  so the version here stays the project.yml fallback and the commit is omitted.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Mewo</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.1</string>
	<key>CFBundleVersion</key>
	<string>2</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>atkinson_hyperlegible_regular.ttf</string>
		<string>atkinson_hyperlegible_bold.ttf</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
